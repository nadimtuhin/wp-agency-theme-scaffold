{
  "name": "nadimtuhin/wp-agency-theme-scaffold",
  "description": "OOP backend classes for custom WordPress agency theme",
  "type": "wordpress-theme",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Nadim Tuhin",
      "email": "nadimtuhin@gmail.com",
      "homepage": "https://nadimtuhin.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "AgencyTheme\\": "includes/"
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.33"
    }
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf"
  }
}
